    <mxCell id="storage" value="&lt;b&gt;Azure Storage / SQL&lt;/b&gt;&lt;br&gt;Data-plane access via Managed Identity + RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="785" y="490" width="320" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="flowNote" value="&lt;b&gt;Request flow&lt;/b&gt;&lt;br&gt;1  Function requests a token for its Managed Identity (IMDS) &#8212; no secret&lt;br&gt;2  Entra ID returns a short-lived access token&lt;br&gt;3  Call Key Vault via Private Endpoint; Private DNS resolves FQDN &#8594; private IP&lt;br&gt;4  Key Vault RBAC authorizes &#8594; returns secret&lt;br&gt;5  Access data with the same identity (RBAC data-plane)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="70" y="640" width="380" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="xcloudNote" value="&lt;b&gt;Zero-secrets principle &#8212; transfers across clouds&lt;/b&gt;&lt;br&gt;Short-lived, identity-based auth replaces static secrets &#8212; the same lesson as removing the client-side API key from the AWS SOC project.&lt;br&gt;&lt;b&gt;AWS:&lt;/b&gt; IAM roles / GitHub OIDC&lt;br&gt;&lt;b&gt;Azure:&lt;/b&gt; Managed Identity + Key Vault + RBAC" style="rounded=1;shadow=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="465" y="640" width="360" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="rbacNote" value="&lt;b&gt;RBAC role assignments &#8212; no secrets&lt;/b&gt;&lt;br&gt;&#8226; MI &#8594; Key Vault Secrets User&lt;br&gt;&#160;&#160;&#160;(scope: the vault)&lt;br&gt;&#8226; MI &#8594; Storage Blob Data Reader&lt;br&gt;&#160;&#160;&#160;(scope: the data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="840" y="640" width="280" height="160" as="geometry"/>
